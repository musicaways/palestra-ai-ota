# ---------------------------------------------------------------------------
# InkBridge — configurazione dell'hub sul NAS
# Copia questo file in .env e adatta i valori.
# ---------------------------------------------------------------------------

# Token condiviso richiesto dal Kobo a ogni chiamata.
# Genera con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Lascia vuoto SOLO se il servizio non esce dalla LAN.
INKBRIDGE_TOKEN=cambiami-con-un-token-lungo

# --- Calibre ---------------------------------------------------------------
# URL di calibre-server (quello che serve /opds e /ajax), non di calibre-web.
INKBRIDGE_CALIBRE_URL=http://192.168.1.10:8080
INKBRIDGE_CALIBRE_USERNAME=
INKBRIDGE_CALIBRE_PASSWORD=
# Vuoto = libreria predefinita del server.
INKBRIDGE_CALIBRE_LIBRARY=
# auto | basic | digest  (calibre-server usa digest per impostazione predefinita)
INKBRIDGE_CALIBRE_AUTH_MODE=auto
# Formati accettati, in ordine di preferenza. kepub sfrutta il motore nativo Kobo.
INKBRIDGE_CALIBRE_FORMATS=kepub,epub,cbz,pdf
# Scrive la posizione di lettura anche dentro Calibre.
INKBRIDGE_CALIBRE_WRITE_POSITIONS=true

# --- Suwayomi --------------------------------------------------------------
INKBRIDGE_SUWAYOMI_URL=http://192.168.1.10:4567
INKBRIDGE_SUWAYOMI_USERNAME=
INKBRIDGE_SUWAYOMI_PASSWORD=
INKBRIDGE_SUWAYOMI_WRITE_POSITIONS=true
# Oltre questa frazione del capitolo, il capitolo risulta letto su Suwayomi.
INKBRIDGE_MANGA_READ_THRESHOLD=0.95

# --- Sincronizzazione ------------------------------------------------------
# Ogni quanti secondi cercare letture fatte altrove (viewer web, Mihon...).
INKBRIDGE_POLL_INTERVAL=900
# Cadenza dei tentativi di writeback falliti.
INKBRIDGE_WRITEBACK_RETRY_INTERVAL=120
# Durata della cache del catalogo.
INKBRIDGE_CATALOG_TTL=300
INKBRIDGE_HTTP_TIMEOUT=30

# --- Servizio --------------------------------------------------------------
INKBRIDGE_PORT=8577
INKBRIDGE_DATA_DIR=/data
INKBRIDGE_LOG_LEVEL=INFO
